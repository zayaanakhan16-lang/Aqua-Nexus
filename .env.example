# AquaNexus environment template.
#
# Copy this file to `.env` and fill in values as needed. NEVER commit a real
# `.env` file. Only the public backend base URL belongs in the frontend; all
# credentials stay server-side.
#
# Where the backend looks (highest precedence last, real env vars always win):
#   <repo>/.env.local  ->  <repo>/.env  ->  backend/.env
# The backend resolves these paths relative to itself, so it works whether you
# start it from the repository root or from backend/. Note that the frontend's
# Next.js `.env.local` is NOT read by Python: a key placed only there will not
# reach the AI analysis. Put server-side secrets in `backend/.env`.
#
# The application runs fully without any credential below. Credential-gated
# providers simply report an explicit `unconfigured` state.

# ---------------------------------------------------------------------------
# Backend (Python / FastAPI). All variables are prefixed with AQUANEXUS_.
# ---------------------------------------------------------------------------
AQUANEXUS_ENVIRONMENT=development
AQUANEXUS_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
AQUANEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTP + cache tuning.
AQUANEXUS_PROVIDER_TIMEOUT_SECONDS=20
AQUANEXUS_PROVIDER_MAX_RETRIES=2
AQUANEXUS_CACHE_TTL_SECONDS=300
AQUANEXUS_CACHE_MAX_ENTRIES=512

# --- Optional provider credentials ---
# NASA POWER works without a key. Set only if your deployment proxies it.
AQUANEXUS_NASA_POWER_API_KEY=

# Copernicus Data Space Ecosystem (for authenticated STAC downloads only;
# catalogue search is anonymous and works without this).
AQUANEXUS_CDSE_USERNAME=
AQUANEXUS_CDSE_PASSWORD=

# NASA Earthdata token (personal access token). Needed only for GPM IMERG
# downloads; NASA POWER does not require it. Create at
# https://urs.earthdata.nasa.gov/.
AQUANEXUS_EARTHDATA_TOKEN=

# NASA Earthdata Login username/password. Used ONLY server-side to obtain
# short-lived (1-hour) AWS S3 credentials from the GES DISC /s3credentials
# endpoint for GPM IMERG (GPM_3IMERGDL). Leave blank to keep IMERG in an
# explicit "unconfigured" state. Never exposed to the browser.
#
# NOTE: NASA HLS (Harmonized Landsat Sentinel-2) discovery does NOT need these.
# HLS granule metadata is searched through the anonymous CMR STAC API, and the
# HLS/OPERA map layers are public NASA GIBS tiles.
AQUANEXUS_EARTHDATA_USERNAME=
AQUANEXUS_EARTHDATA_PASSWORD=

# --- AI analysis (optional) ---
# Groq is the preferred provider. Set GROQ_API_KEY to enable evidence-grounded
# AI interpretation. Leave it blank to keep AI Analysis in an explicit
# "unconfigured" state; the rest of the application — including the PDF report,
# which then uses a factual non-AI summary — works without it.
#
# The key is read with its conventional name (no AQUANEXUS_ prefix needed) and
# is used server-side only. It is never sent to the browser or logged. Do not
# commit a real key.
GROQ_API_KEY=
# A currently supported Groq model id. See https://console.groq.com/docs/models
# Default: openai/gpt-oss-120b (Groq's documented replacement for the retired
# qwen/qwen3-32b). Override only with a model your Groq plan serves.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: a non-Groq OpenAI-compatible endpoint. Used ONLY when GROQ_API_KEY
# is unset, so setting GROQ_API_KEY never silently falls back to another
# provider.
AQUANEXUS_AI_API_KEY=
AQUANEXUS_AI_BASE_URL=https://api.openai.com/v1
AQUANEXUS_AI_MODEL=gpt-4o-mini
AQUANEXUS_AI_TIMEOUT_SECONDS=45

# --- GPM IMERG (GES DISC) access ---
# These defaults match the documented V07 layout and normally need no change.
# They exist so tests can point at fixtures and so a future bucket move is a
# one-line change.
# AQUANEXUS_GESDISC_S3CREDENTIALS_URL=https://data.gesdisc.earthdata.nasa.gov/s3credentials
# AQUANEXUS_GESDISC_S3_ENDPOINT=https://gesdisc-cumulus-prod-protected.s3.us-west-2.amazonaws.com
# AQUANEXUS_GESDISC_S3_REGION=us-west-2
# AQUANEXUS_GESDISC_S3_BUCKET=gesdisc-cumulus-prod-protected
# AQUANEXUS_GESDISC_IMERG_PREFIX=GPM_L3/GPM_3IMERGDL.07
# Bounded download / range guards.
# AQUANEXUS_IMERG_MAX_DOWNLOAD_BYTES=67108864
# AQUANEXUS_IMERG_MAX_DAYS=366

# To read IMERG NetCDF4 granules install the optional extra (see README):
#   pip install -e "backend[imerg]"

# ---------------------------------------------------------------------------
# Frontend (Next.js). Only public, non-secret values here.
# ---------------------------------------------------------------------------
# Server-side origin the Next.js proxy forwards /api/* to. Not exposed to the
# browser. Default: http://localhost:8000
AQUANEXUS_BACKEND_ORIGIN=http://localhost:8000

# Only needed when the API lives on a different origin than the frontend
# (the proxy makes this unnecessary in the default setup). Public by nature.
NEXT_PUBLIC_API_BASE_URL=
